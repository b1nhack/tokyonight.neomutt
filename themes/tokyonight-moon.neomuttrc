# vim: filetype=neomuttrc

# Tokyo Night (moon) theme for NeoMutt
# Palette: https://github.com/folke/tokyonight.nvim (style: moon)
# Generated by scripts/generate_themes.py — do not edit by hand.
#
# This variant uses the 256-color palette, so it works on any terminal.
# For the exact Tokyo Night colors use the truecolor variant instead
# (themes/truecolor/, see the README).


# --------------------------------------------------------------------------
# general
color normal color189 default                           # text is "text"
color error color210 default                            # error messages
color warning color222 default                          # warning messages
color message color150 default                          # informational messages
color options bold color141 default                     # key letters in multi-choice questions
color prompt bold color111 default                      # a question
color progress color111 color237                        # visual progress bar
color status color103 default                           # status bar
color indicator color189 color237                       # current item in a menu
color tree color103 default                             # thread tree arrows
color tilde color61 default                             # "~" padding in the pager
color markers color209 default                          # "+" wrapped-line markers
color hdrdefault color103 default                       # default header text in the pager
color header color111 default "^From:"                  # header labels are titles
color header color111 default "^(To|Cc):"
color header color111 default "^Subject:"
color header color111 default "^Date:"
color attachment color141 default                       # attachment headers
color attach_headers color67 default ".*"               # attachment header block
color search default color62                            # search matches in the pager
color signature color61 default                         # signature lines
color bold bold color189 default                        # bold text in message bodies
color underline underline color189 default              # underlined text in message bodies
color italic italic color189 default                    # italic text in message bodies
color stripe_even default default                       # help-page stripes: even lines stay transparent
color stripe_odd default color235                       # help-page stripes: odd lines get a subtle tint

# --------------------------------------------------------------------------
# sidebar
color sidebar_background color103 color235              # the sidebar panel
color sidebar_divider color237 default                  # sidebar/index divider
color sidebar_highlight color189 color237               # sidebar cursor
color sidebar_indicator color111 default                # mailbox open in the index
color sidebar_new color150 default                      # mailboxes with new mail
color sidebar_unread color222 default                   # mailboxes with unread mail
color sidebar_flagged color210 default                  # mailboxes with flagged mail
color sidebar_ordinary color67 default                  # mailboxes with nothing special
color sidebar_spool_file color79 default                # the incoming-mail mailbox

# --------------------------------------------------------------------------
# compose
color compose_header bold color111 default              # header labels, e.g. From:
color compose_security_none color67 default             # mail will not be encrypted or signed
color compose_security_sign color117 default            # mail will be signed
color compose_security_encrypt color111 default         # mail will be encrypted
color compose_security_both color79 default             # mail will be encrypted and signed

# --------------------------------------------------------------------------
# quoted text
color quoted color103 default                           # quoted text, level 0 (quoted0; "quoted" kept for older NeoMutt)
color quoted1 color117 default                          # quoted text, level 1
color quoted2 color117 default                          # quoted text, level 2
color quoted3 color61 default                           # quoted text, level 3
color quoted4 color67 default                           # quoted text, level 4
color quoted5 color60 default                           # quoted text, level 5
color quoted6 color60 default                           # quoted text, level 6
color quoted7 color60 default                           # quoted text, level 7
color quoted8 color60 default                           # quoted text, level 8
color quoted9 color60 default                           # quoted text, level 9

# --------------------------------------------------------------------------
# index: whole-line flag colors
color index color150 default ~N                         # new messages
color index color210 default ~F                         # flagged messages
color index color141 default ~T                         # tagged messages
color index color210 default ~D                         # messages to delete

# --------------------------------------------------------------------------
# index: per-column colors
# (author/subject use a complement pattern so they are only tinted on
# lines that have no whole-line flag color)
color index_number color60 default ".*"                 # message number column
color index_size color60 default ".*"                   # message size column
color index_date color61 default ".*"                   # date column
color index_flags color209 default ".*"                 # flags column
color index_collapsed color222 default ".*"             # collapsed-thread count
color index_label color141 default ".*"                 # label column
color index_tags color79 default ".*"                   # transformed tags column
color index_tag color79 default ".*"                    # tags column
color index_author color111 default "!(~N|~F|~T|~D)"    # author column (except on flag-colored lines)
color index_subject color189 default "!(~N|~F|~T|~D)"   # subject column (except on flag-colored lines)

# --------------------------------------------------------------------------
# message body: addresses, URLs, markup
color body color79 default ([\-\.+_a-zA-Z0-9]+@[\-\.a-zA-Z0-9]+) # email addresses
color body color79 default (https?|ftp)://[\-\.,/%~_:?&=\#a-zA-Z0-9]+ # URLs
color body bold color117 default (^|[[:space:]])\*[^[:space:]]+\*([[:space:]]|$) # *bold* markup
color body underline color117 default (^|[[:space:]])_[^[:space:]]+_([[:space:]]|$) # _underlined_ markup
color body italic color117 default (^|[[:space:]])/[^[:space:]]+/([[:space:]]|$) # /italic/ markup

# --------------------------------------------------------------------------
# status bar counters
color status color150 default 'New:[0-9]+'              # new-mail counter
color status color210 default 'Del:[0-9]+'              # deleted counter
color status color210 default 'Flag:[0-9]+'             # flagged counter
color status color222 default 'Post:[0-9]+'             # postponed counter
