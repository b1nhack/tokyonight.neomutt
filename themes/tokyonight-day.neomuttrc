# vim: filetype=neomuttrc

# Tokyo Night (day) theme for NeoMutt
# Palette: https://github.com/folke/tokyonight.nvim (style: day)
# Generated by scripts/generate_themes.py — do not edit by hand.
#
# This variant uses the 256-color palette, so it works on any terminal.
# For the exact Tokyo Night colors use the truecolor variant instead
# (themes/truecolor/, see the README).


# --------------------------------------------------------------------------
# general
color normal color61 default                            # text is "text"
color error color197 default                            # error messages
color warning color95 default                           # warning messages
color message color65 default                           # informational messages
color options bold color99 default                      # key letters in multi-choice questions
color prompt bold color32 default                       # a question
color progress color32 color252                         # visual progress bar
color status color61 default                            # status bar
color indicator color61 color252                        # current item in a menu
color tree color61 default                              # thread tree arrows
color tilde color103 default                            # "~" padding in the pager
color markers color130 default                          # "+" wrapped-line markers
color hdrdefault color61 default                        # default header text in the pager
color header color32 default "^From:"                   # header labels are titles
color header color32 default "^(To|Cc):"
color header color32 default "^Subject:"
color header color32 default "^Date:"
color attachment color99 default                        # attachment headers
color attach_headers color60 default ".*"               # attachment header block
color search default color104                           # search matches in the pager
color signature color103 default                        # signature lines
color bold bold color61 default                         # bold text in message bodies
color underline underline color61 default               # underlined text in message bodies
color italic italic color61 default                     # italic text in message bodies
color stripe_even default default                       # help-page stripes: even lines stay transparent
color stripe_odd default color253                       # help-page stripes: odd lines get a subtle tint

# --------------------------------------------------------------------------
# sidebar
color sidebar_background color61 color253               # the sidebar panel
color sidebar_divider color252 default                  # sidebar/index divider
color sidebar_highlight color61 color252                # sidebar cursor
color sidebar_indicator color32 default                 # mailbox open in the index
color sidebar_new color65 default                       # mailboxes with new mail
color sidebar_unread color95 default                    # mailboxes with unread mail
color sidebar_flagged color197 default                  # mailboxes with flagged mail
color sidebar_ordinary color60 default                  # mailboxes with nothing special
color sidebar_spool_file color30 default                # the incoming-mail mailbox

# --------------------------------------------------------------------------
# compose
color compose_header bold color32 default               # header labels, e.g. From:
color compose_security_none color60 default             # mail will not be encrypted or signed
color compose_security_sign color24 default             # mail will be signed
color compose_security_encrypt color32 default          # mail will be encrypted
color compose_security_both color241 default            # mail will be encrypted and signed

# --------------------------------------------------------------------------
# quoted text
color quoted color61 default                            # quoted text, level 0 (quoted0; "quoted" kept for older NeoMutt)
color quoted1 color24 default                           # quoted text, level 1
color quoted2 color24 default                           # quoted text, level 2
color quoted3 color103 default                          # quoted text, level 3
color quoted4 color60 default                           # quoted text, level 4
color quoted5 color103 default                          # quoted text, level 5
color quoted6 color103 default                          # quoted text, level 6
color quoted7 color103 default                          # quoted text, level 7
color quoted8 color103 default                          # quoted text, level 8
color quoted9 color103 default                          # quoted text, level 9

# --------------------------------------------------------------------------
# index: whole-line flag colors
color index color65 default ~N                          # new messages
color index color197 default ~F                         # flagged messages
color index color99 default ~T                          # tagged messages
color index color197 default ~D                         # messages to delete

# --------------------------------------------------------------------------
# index: per-column colors
# (author/subject use a complement pattern so they are only tinted on
# lines that have no whole-line flag color)
color index_number color103 default ".*"                # message number column
color index_size color103 default ".*"                  # message size column
color index_date color103 default ".*"                  # date column
color index_flags color130 default ".*"                 # flags column
color index_collapsed color95 default ".*"              # collapsed-thread count
color index_label color99 default ".*"                  # label column
color index_tags color241 default ".*"                  # transformed tags column
color index_tag color241 default ".*"                   # tags column
color index_author color32 default "!(~N|~F|~T|~D)"     # author column (except on flag-colored lines)
color index_subject color61 default "!(~N|~F|~T|~D)"    # subject column (except on flag-colored lines)

# --------------------------------------------------------------------------
# message body: addresses, URLs, markup
color body color30 default ([\-\.+_a-zA-Z0-9]+@[\-\.a-zA-Z0-9]+) # email addresses
color body color30 default (https?|ftp)://[\-\.,/%~_:?&=\#a-zA-Z0-9]+ # URLs
color body bold color24 default (^|[[:space:]])\*[^[:space:]]+\*([[:space:]]|$) # *bold* markup
color body underline color24 default (^|[[:space:]])_[^[:space:]]+_([[:space:]]|$) # _underlined_ markup
color body italic color24 default (^|[[:space:]])/[^[:space:]]+/([[:space:]]|$) # /italic/ markup

# --------------------------------------------------------------------------
# status bar counters
color status color65 default 'New:[0-9]+'               # new-mail counter
color status color197 default 'Del:[0-9]+'              # deleted counter
color status color197 default 'Flag:[0-9]+'             # flagged counter
color status color95 default 'Post:[0-9]+'              # postponed counter
