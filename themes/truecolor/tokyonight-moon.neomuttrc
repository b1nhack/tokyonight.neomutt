# vim: filetype=neomuttrc

# Tokyo Night (moon) theme for NeoMutt
# Palette: https://github.com/folke/tokyonight.nvim (style: moon)
# Generated by scripts/generate_themes.py — do not edit by hand.
#
# This variant uses exact 24-bit colors. It needs BOTH of:
#   1. set color_directcolor = yes            (done below)
#   2. a TERM whose terminfo advertises 16M colors (e.g. xterm-direct)
# Otherwise every line below errors with "color not supported by term".
# See the README for details.

set color_directcolor = yes


# --------------------------------------------------------------------------
# general
color normal #c8d3f5 default                            # text is "text"
color error #ff757f default                             # error messages
color warning #ffc777 default                           # warning messages
color message #c3e88d default                           # informational messages
color options bold #c099ff default                      # key letters in multi-choice questions
color prompt bold #82aaff default                       # a question
color progress #82aaff #2f334d                          # visual progress bar
color status #828bb8 default                            # status bar
color indicator #c8d3f5 #2f334d                         # current item in a menu
color tree #828bb8 default                              # thread tree arrows
color tilde #636da6 default                             # "~" padding in the pager
color markers #ff966c default                           # "+" wrapped-line markers
color hdrdefault #828bb8 default                        # default header text in the pager
color header #82aaff default "^From:"                   # header labels are titles
color header #82aaff default "^(To|Cc):"
color header #82aaff default "^Subject:"
color header #82aaff default "^Date:"
color attachment #c099ff default                        # attachment headers
color attach_headers #737aa2 default ".*"               # attachment header block
color search default #3e68d7                            # search matches in the pager
color signature #636da6 default                         # signature lines
color bold bold #c8d3f5 default                         # bold text in message bodies
color underline underline #c8d3f5 default               # underlined text in message bodies
color italic italic #c8d3f5 default                     # italic text in message bodies
color stripe_even default default                       # help-page stripes: even lines stay transparent
color stripe_odd default #1e2030                        # help-page stripes: odd lines get a subtle tint

# --------------------------------------------------------------------------
# sidebar
color sidebar_background #828bb8 #1e2030                # the sidebar panel
color sidebar_divider #2f334d default                   # sidebar/index divider
color sidebar_highlight #c8d3f5 #2f334d                 # sidebar cursor
color sidebar_indicator #82aaff default                 # mailbox open in the index
color sidebar_new #c3e88d default                       # mailboxes with new mail
color sidebar_unread #ffc777 default                    # mailboxes with unread mail
color sidebar_flagged #ff757f default                   # mailboxes with flagged mail
color sidebar_ordinary #737aa2 default                  # mailboxes with nothing special
color sidebar_spool_file #4fd6be default                # the incoming-mail mailbox

# --------------------------------------------------------------------------
# compose
color compose_header bold #82aaff default               # header labels, e.g. From:
color compose_security_none #737aa2 default             # mail will not be encrypted or signed
color compose_security_sign #86e1fc default             # mail will be signed
color compose_security_encrypt #82aaff default          # mail will be encrypted
color compose_security_both #4fd6be default             # mail will be encrypted and signed

# --------------------------------------------------------------------------
# quoted text
color quoted #828bb8 default                            # quoted text, level 0 (quoted0; "quoted" kept for older NeoMutt)
color quoted1 #86e1fc default                           # quoted text, level 1
color quoted2 #89ddff default                           # quoted text, level 2
color quoted3 #636da6 default                           # quoted text, level 3
color quoted4 #737aa2 default                           # quoted text, level 4
color quoted5 #545c7e default                           # quoted text, level 5
color quoted6 #545c7e default                           # quoted text, level 6
color quoted7 #545c7e default                           # quoted text, level 7
color quoted8 #545c7e default                           # quoted text, level 8
color quoted9 #545c7e default                           # quoted text, level 9

# --------------------------------------------------------------------------
# index: whole-line flag colors
color index #c3e88d default ~N                          # new messages
color index #ff757f default ~F                          # flagged messages
color index #c099ff default ~T                          # tagged messages
color index #ff757f default ~D                          # messages to delete

# --------------------------------------------------------------------------
# index: per-column colors
# (author/subject use a complement pattern so they are only tinted on
# lines that have no whole-line flag color)
color index_number #545c7e default ".*"                 # message number column
color index_size #545c7e default ".*"                   # message size column
color index_date #636da6 default ".*"                   # date column
color index_flags #ff966c default ".*"                  # flags column
color index_collapsed #ffc777 default ".*"              # collapsed-thread count
color index_label #c099ff default ".*"                  # label column
color index_tags #4fd6be default ".*"                   # transformed tags column
color index_tag #4fd6be default ".*"                    # tags column
color index_author #82aaff default "!(~N|~F|~T|~D)"     # author column (except on flag-colored lines)
color index_subject #c8d3f5 default "!(~N|~F|~T|~D)"    # subject column (except on flag-colored lines)

# --------------------------------------------------------------------------
# message body: addresses, URLs, markup
color body #4fd6be default ([\-\.+_a-zA-Z0-9]+@[\-\.a-zA-Z0-9]+) # email addresses
color body #4fd6be default (https?|ftp)://[\-\.,/%~_:?&=\#a-zA-Z0-9]+ # URLs
color body bold #89ddff default (^|[[:space:]])\*[^[:space:]]+\*([[:space:]]|$) # *bold* markup
color body underline #89ddff default (^|[[:space:]])_[^[:space:]]+_([[:space:]]|$) # _underlined_ markup
color body italic #89ddff default (^|[[:space:]])/[^[:space:]]+/([[:space:]]|$) # /italic/ markup

# --------------------------------------------------------------------------
# status bar counters
color status #c3e88d default 'New:[0-9]+'               # new-mail counter
color status #ff757f default 'Del:[0-9]+'               # deleted counter
color status #ff757f default 'Flag:[0-9]+'              # flagged counter
color status #ffc777 default 'Post:[0-9]+'              # postponed counter
