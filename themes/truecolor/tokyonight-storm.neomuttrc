# vim: filetype=neomuttrc

# Tokyo Night (storm) theme for NeoMutt
# Palette: https://github.com/folke/tokyonight.nvim (style: storm)
# Generated by scripts/generate_themes.py — do not edit by hand.
#
# This variant uses exact 24-bit colors. It needs BOTH of:
#   1. set color_directcolor = yes            (done below)
#   2. a TERM whose terminfo advertises 16M colors (e.g. xterm-direct)
# Otherwise every line below errors with "color not supported by term".
# See the README for details.

set color_directcolor = yes


# --------------------------------------------------------------------------
# general
color normal #c0caf5 default                            # text is "text"
color error #f7768e default                             # error messages
color warning #e0af68 default                           # warning messages
color message #9ece6a default                           # informational messages
color options bold #bb9af7 default                      # key letters in multi-choice questions
color prompt bold #7aa2f7 default                       # a question
color progress #7aa2f7 #292e42                          # visual progress bar
color status #a9b1d6 default                            # status bar
color indicator #c0caf5 #292e42                         # current item in a menu
color tree #a9b1d6 default                              # thread tree arrows
color tilde #565f89 default                             # "~" padding in the pager
color markers #ff9e64 default                           # "+" wrapped-line markers
color hdrdefault #a9b1d6 default                        # default header text in the pager
color header #7aa2f7 default "^From:"                   # header labels are titles
color header #7aa2f7 default "^(To|Cc):"
color header #7aa2f7 default "^Subject:"
color header #7aa2f7 default "^Date:"
color attachment #bb9af7 default                        # attachment headers
color attach_headers #737aa2 default ".*"               # attachment header block
color search default #3d59a1                            # search matches in the pager
color signature #565f89 default                         # signature lines
color bold bold #c0caf5 default                         # bold text in message bodies
color underline underline #c0caf5 default               # underlined text in message bodies
color italic italic #c0caf5 default                     # italic text in message bodies
color stripe_even default default                       # help-page stripes: even lines stay transparent
color stripe_odd default #1f2335                        # help-page stripes: odd lines get a subtle tint

# --------------------------------------------------------------------------
# sidebar
color sidebar_background #a9b1d6 #1f2335                # the sidebar panel
color sidebar_divider #292e42 default                   # sidebar/index divider
color sidebar_highlight #c0caf5 #292e42                 # sidebar cursor
color sidebar_indicator #7aa2f7 default                 # mailbox open in the index
color sidebar_new #9ece6a default                       # mailboxes with new mail
color sidebar_unread #e0af68 default                    # mailboxes with unread mail
color sidebar_flagged #f7768e default                   # mailboxes with flagged mail
color sidebar_ordinary #737aa2 default                  # mailboxes with nothing special
color sidebar_spool_file #1abc9c default                # the incoming-mail mailbox

# --------------------------------------------------------------------------
# compose
color compose_header bold #7aa2f7 default               # header labels, e.g. From:
color compose_security_none #737aa2 default             # mail will not be encrypted or signed
color compose_security_sign #7dcfff default             # mail will be signed
color compose_security_encrypt #7aa2f7 default          # mail will be encrypted
color compose_security_both #73daca default             # mail will be encrypted and signed

# --------------------------------------------------------------------------
# quoted text
color quoted #a9b1d6 default                            # quoted text, level 0 (quoted0; "quoted" kept for older NeoMutt)
color quoted1 #7dcfff default                           # quoted text, level 1
color quoted2 #89ddff default                           # quoted text, level 2
color quoted3 #565f89 default                           # quoted text, level 3
color quoted4 #737aa2 default                           # quoted text, level 4
color quoted5 #545c7e default                           # quoted text, level 5
color quoted6 #545c7e default                           # quoted text, level 6
color quoted7 #545c7e default                           # quoted text, level 7
color quoted8 #545c7e default                           # quoted text, level 8
color quoted9 #545c7e default                           # quoted text, level 9

# --------------------------------------------------------------------------
# index: whole-line flag colors
color index #9ece6a default ~N                          # new messages
color index #f7768e default ~F                          # flagged messages
color index #bb9af7 default ~T                          # tagged messages
color index #f7768e default ~D                          # messages to delete

# --------------------------------------------------------------------------
# index: per-column colors
# (author/subject use a complement pattern so they are only tinted on
# lines that have no whole-line flag color)
color index_number #545c7e default ".*"                 # message number column
color index_size #545c7e default ".*"                   # message size column
color index_date #565f89 default ".*"                   # date column
color index_flags #ff9e64 default ".*"                  # flags column
color index_collapsed #e0af68 default ".*"              # collapsed-thread count
color index_label #bb9af7 default ".*"                  # label column
color index_tags #73daca default ".*"                   # transformed tags column
color index_tag #73daca default ".*"                    # tags column
color index_author #7aa2f7 default "!(~N|~F|~T|~D)"     # author column (except on flag-colored lines)
color index_subject #c0caf5 default "!(~N|~F|~T|~D)"    # subject column (except on flag-colored lines)

# --------------------------------------------------------------------------
# message body: addresses, URLs, markup
color body #1abc9c default ([\-\.+_a-zA-Z0-9]+@[\-\.a-zA-Z0-9]+) # email addresses
color body #1abc9c default (https?|ftp)://[\-\.,/%~_:?&=\#a-zA-Z0-9]+ # URLs
color body bold #89ddff default (^|[[:space:]])\*[^[:space:]]+\*([[:space:]]|$) # *bold* markup
color body underline #89ddff default (^|[[:space:]])_[^[:space:]]+_([[:space:]]|$) # _underlined_ markup
color body italic #89ddff default (^|[[:space:]])/[^[:space:]]+/([[:space:]]|$) # /italic/ markup

# --------------------------------------------------------------------------
# status bar counters
color status #9ece6a default 'New:[0-9]+'               # new-mail counter
color status #f7768e default 'Del:[0-9]+'               # deleted counter
color status #f7768e default 'Flag:[0-9]+'              # flagged counter
color status #e0af68 default 'Post:[0-9]+'              # postponed counter
