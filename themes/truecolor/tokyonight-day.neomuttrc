# vim: filetype=neomuttrc

# Tokyo Night (day) theme for NeoMutt
# Palette: https://github.com/folke/tokyonight.nvim (style: day)
# Generated by scripts/generate_themes.py — do not edit by hand.
#
# This variant uses exact 24-bit colors. It needs BOTH of:
#   1. set color_directcolor = yes            (done below)
#   2. a TERM whose terminfo advertises 16M colors (e.g. xterm-direct)
# Otherwise every line below errors with "color not supported by term".
# See the README for details.

set color_directcolor = yes


# --------------------------------------------------------------------------
# general
color normal #3760bf default                            # text is "text"
color error #f52a65 default                             # error messages
color warning #8c6c3e default                           # warning messages
color message #587539 default                           # informational messages
color options bold #9854f1 default                      # key letters in multi-choice questions
color prompt bold #2e7de9 default                       # a question
color progress #2e7de9 #c4c8da                          # visual progress bar
color status #6172b0 default                            # status bar
color indicator #3760bf #c4c8da                         # current item in a menu
color tree #6172b0 default                              # thread tree arrows
color tilde #848cb5 default                             # "~" padding in the pager
color markers #b15c00 default                           # "+" wrapped-line markers
color hdrdefault #6172b0 default                        # default header text in the pager
color header #2e7de9 default "^From:"                   # header labels are titles
color header #2e7de9 default "^(To|Cc):"
color header #2e7de9 default "^Subject:"
color header #2e7de9 default "^Date:"
color attachment #9854f1 default                        # attachment headers
color attach_headers #68709a default ".*"               # attachment header block
color search default #7890dd                            # search matches in the pager
color signature #848cb5 default                         # signature lines
color bold bold #3760bf default                         # bold text in message bodies
color underline underline #3760bf default               # underlined text in message bodies
color italic italic #3760bf default                     # italic text in message bodies
color stripe_even default default                       # help-page stripes: even lines stay transparent
color stripe_odd default #d0d5e3                        # help-page stripes: odd lines get a subtle tint

# --------------------------------------------------------------------------
# sidebar
color sidebar_background #6172b0 #d0d5e3                # the sidebar panel
color sidebar_divider #c4c8da default                   # sidebar/index divider
color sidebar_highlight #3760bf #c4c8da                 # sidebar cursor
color sidebar_indicator #2e7de9 default                 # mailbox open in the index
color sidebar_new #587539 default                       # mailboxes with new mail
color sidebar_unread #8c6c3e default                    # mailboxes with unread mail
color sidebar_flagged #f52a65 default                   # mailboxes with flagged mail
color sidebar_ordinary #68709a default                  # mailboxes with nothing special
color sidebar_spool_file #118c74 default                # the incoming-mail mailbox

# --------------------------------------------------------------------------
# compose
color compose_header bold #2e7de9 default               # header labels, e.g. From:
color compose_security_none #68709a default             # mail will not be encrypted or signed
color compose_security_sign #007197 default             # mail will be signed
color compose_security_encrypt #2e7de9 default          # mail will be encrypted
color compose_security_both #387068 default             # mail will be encrypted and signed

# --------------------------------------------------------------------------
# quoted text
color quoted #6172b0 default                            # quoted text, level 0 (quoted0; "quoted" kept for older NeoMutt)
color quoted1 #007197 default                           # quoted text, level 1
color quoted2 #006a83 default                           # quoted text, level 2
color quoted3 #848cb5 default                           # quoted text, level 3
color quoted4 #68709a default                           # quoted text, level 4
color quoted5 #8990b3 default                           # quoted text, level 5
color quoted6 #8990b3 default                           # quoted text, level 6
color quoted7 #8990b3 default                           # quoted text, level 7
color quoted8 #8990b3 default                           # quoted text, level 8
color quoted9 #8990b3 default                           # quoted text, level 9

# --------------------------------------------------------------------------
# index: whole-line flag colors
color index #587539 default ~N                          # new messages
color index #f52a65 default ~F                          # flagged messages
color index #9854f1 default ~T                          # tagged messages
color index #f52a65 default ~D                          # messages to delete

# --------------------------------------------------------------------------
# index: per-column colors
# (author/subject use a complement pattern so they are only tinted on
# lines that have no whole-line flag color)
color index_number #8990b3 default ".*"                 # message number column
color index_size #8990b3 default ".*"                   # message size column
color index_date #848cb5 default ".*"                   # date column
color index_flags #b15c00 default ".*"                  # flags column
color index_collapsed #8c6c3e default ".*"              # collapsed-thread count
color index_label #9854f1 default ".*"                  # label column
color index_tags #387068 default ".*"                   # transformed tags column
color index_tag #387068 default ".*"                    # tags column
color index_author #2e7de9 default "!(~N|~F|~T|~D)"     # author column (except on flag-colored lines)
color index_subject #3760bf default "!(~N|~F|~T|~D)"    # subject column (except on flag-colored lines)

# --------------------------------------------------------------------------
# message body: addresses, URLs, markup
color body #118c74 default ([\-\.+_a-zA-Z0-9]+@[\-\.a-zA-Z0-9]+) # email addresses
color body #118c74 default (https?|ftp)://[\-\.,/%~_:?&=\#a-zA-Z0-9]+ # URLs
color body bold #006a83 default (^|[[:space:]])\*[^[:space:]]+\*([[:space:]]|$) # *bold* markup
color body underline #006a83 default (^|[[:space:]])_[^[:space:]]+_([[:space:]]|$) # _underlined_ markup
color body italic #006a83 default (^|[[:space:]])/[^[:space:]]+/([[:space:]]|$) # /italic/ markup

# --------------------------------------------------------------------------
# status bar counters
color status #587539 default 'New:[0-9]+'               # new-mail counter
color status #f52a65 default 'Del:[0-9]+'               # deleted counter
color status #f52a65 default 'Flag:[0-9]+'              # flagged counter
color status #8c6c3e default 'Post:[0-9]+'              # postponed counter
